# ConceptAI configuration. Copy to .env.local and fill in what you have.
# Every key here is read on the server only; none of them is sent to the browser.
# With nothing configured the app still runs: built-in sample lessons, browser
# voice and browser speech recognition all work without keys.

# ---------------------------------------------------------------------------
# LLM (required for generating new lessons, answers, notes and quizzes)
# ---------------------------------------------------------------------------
# LLM_PROVIDER: "anthropic" (Claude, official SDK) or "openai" (any
# OpenAI-compatible API: OpenAI, Groq, OpenRouter, Together, vLLM, LM Studio)
# or "ollama" (local Ollama, no key needed).
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional overrides. Defaults: anthropic -> claude-opus-5-5,
# openai -> https://api.openai.com/v1 + gpt-4o-mini, ollama -> http://localhost:11434/v1
LLM_MODEL=
LLM_BASE_URL=

# Claude only: reasoning effort (low | medium | high). Lower is faster.
ANTHROPIC_EFFORT=medium
# Claude only: retry declined requests on Anthropic's recommended fallback model
# (server-side "fallbacks", beta server-side-fallback-2026-07-01). Set to "off"
# when LLM_BASE_URL points at a proxy that rejects the field.
ANTHROPIC_FALLBACKS=default

# Routing: School and JEE/NEET lessons go to a cheaper "fast" model, College and
# Advanced lessons (or any topic the plan rates advanced) go to LLM_MODEL.
# With Claude the fast model defaults to claude-sonnet-5-5 (claude-haiku-5-5 is
# cheaper still). Set LLM_FAST_PROVIDER to use a different provider for it,
# e.g. LLM_FAST_PROVIDER=ollama + LLM_FAST_MODEL=qwen3:4b-instruct.
LLM_FAST_MODEL=
LLM_FAST_PROVIDER=
LLM_FAST_API_KEY=
LLM_FAST_BASE_URL=

# Research before teaching (College/Advanced by default, or when the learner asks):
# Claude uses Anthropic's web search tool (billed per search); other providers
# read Wikipedia. Set to "off" to disable.
LLM_RESEARCH=auto

# OpenAI-compatible only: ask for JSON mode (response_format=json_object).
# Turn off for servers that reject the parameter.
LLM_JSON_MODE=true

# Google Gemini, free tier (key from https://aistudio.google.com/apikey). When
# set, Gemini teaches first and everything else configured here becomes its
# backup, in order: LLM_*, then LLM_FALLBACK_*, LLM_FALLBACK2_*, LLM_FALLBACK3_*.
# Its free per-minute budget is far larger than Groq's, so long PDFs fit.
# Free-tier prompts may be used by Google to improve its products.
# GEMINI_API_KEY=
#   GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite   # tried in order (default)
#   GEMINI_VERIFY_MODEL=gemini-3.8-flash                   # fact-checker (default: the first)
#   GEMINI_REASONING_EFFORT=low

# Ollama example (local, free):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen3-vl:4b-instruct
#   OLLAMA_NUM_CTX=8192   # context window; raise it on big GPUs, keep it small on 4-8 GB ones
# Groq example (free tier, key from console.groq.com):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_JSON_MODE=false        # ConceptAI parses the JSON itself
#   LLM_TPM_LIMIT=8000         # free-tier tokens/minute: requests are sized to fit, 429s are retried
#   LLM_REASONING_EFFORT=low   # gpt-oss thinks briefly, saving your daily free tokens
#   LLM_VERIFY_MODEL=openai/gpt-oss-20b     # fact-check on another model: its own daily allowance
#   LLM_FALLBACK_MODELS=openai/gpt-oss-20b  # keep teaching when the main model hits its daily limit
#   LLM_FALLBACK_PROVIDER=ollama            # and when every Groq model is used up, or you're offline,
#   LLM_FALLBACK_MODEL=qwen3-vl:4b-instruct #   teach with a model on this computer (slower, less precise)
#
# Fact-checking: every lesson part, answer, set of notes and quiz is reviewed by
# a second examiner-style pass (corrections replace the original before it is
# played). LLM_VERIFY=off turns it off; LLM_VERIFY_MODEL picks the checker.
# LLM_FALLBACK_MODELS (comma-separated, same provider) are used in order when a
# model is out of quota. LLM_FALLBACK_PROVIDER (+ _MODEL, _BASE_URL, _API_KEY)
# is a second provider, tried last: when the main one is out of quota, still
# rate-limited after two minutes, unreachable or failing, or set up wrong (a
# rejected key or unknown model keeps teaching on the fallback and is shown in
# red in the sidebar). The student is told which model is teaching. The
# stand-in never fact-checks; whatever it writes is checked automatically once
# the checker is back (every 5 minutes while the lesson or notes are open).
#
# A local Ollama fallback starts Ollama itself if it isn't running (~8 s).
# OLLAMA_AUTOSTART=off disables that; OLLAMA_BIN=<path> if `ollama` isn't on PATH.

# ---------------------------------------------------------------------------
# AI voice (optional; the browser's built-in speech is the fallback)
# ---------------------------------------------------------------------------
# TTS_PROVIDER: "openai" (OpenAI-compatible /audio/speech) or "elevenlabs"
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=
# openai defaults: gpt-4o-mini-tts / voice "alloy". elevenlabs: eleven_flash_v2_5 + a voice id.
TTS_MODEL=
TTS_VOICE=

# ---------------------------------------------------------------------------
# AI speech recognition (optional; Chrome/Edge speech recognition is the fallback)
# ---------------------------------------------------------------------------
# OpenAI-compatible /audio/transcriptions (OpenAI whisper-1, Groq whisper-large-v3-turbo).
# STT_PROVIDER=groq uses Groq's Whisper; if LLM_BASE_URL is Groq too, LLM_API_KEY is reused.
STT_PROVIDER=
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=

# ---------------------------------------------------------------------------
# Persistence (optional; without it lessons and notes are kept in this
# browser's IndexedDB). Run supabase/schema.sql and enable anonymous sign-ins.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
