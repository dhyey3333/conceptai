                    "latex": "\\sum_{i=1}^{n-1} (n-i) = (n-1) + (n-2) + \\dots + 1",
                    "note": "expand sum"
                  },
                  {
                    "latex": "= \\frac{n(n-1)}{2}",
                    "note": "arithmetic series formula"
                  },
                  {
                    "latex": "= \\frac{n^2 - n}{2}",
                    "note": "expand numerator"
                  }
                ]
              }
            ]
          },
